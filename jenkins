pipeline {
    agent any

    <!-- tools {
        maven 'maven-3.8.4'
    } -->

    stages {
        stage('Checkout') {
            steps {
                git : 'main',
                url: 'https://github.com/RagulKannan2005/pipeline.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean install -DskipTests=true'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }
    }

    post {
        success {
            echo 'Build and Test successful!'
        }
        failure {
            echo 'Build or Test failed.'
        }
    }
}